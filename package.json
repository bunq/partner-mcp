{
  "name": "bunq-partner-mcp",
  "version": "1.0.0",
  "description": "MCP server for the bunq Partner API",
  "type": "module",
  "bin": {
    "bunq-partner-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:knowledge": "tsc && node dist/knowledge/index-build.js",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "tsc && node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
